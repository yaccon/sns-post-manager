{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sns-post-manager-free-ai-beta",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  },
  "secrets": {
    "required": [
      "GEMINI_API_KEY",
      "TURNSTILE_SECRET"
    ]
  },
  "ratelimits": [
    {
      "name": "USER_LIMITER",
      "namespace_id": "46001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "GLOBAL_LIMITER",
      "namespace_id": "46002",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
